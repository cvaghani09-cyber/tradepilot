# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/tradepilot"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set true when running behind a proxy/Vercel preview
AUTH_TRUST_HOST=true

# File storage: "local" (dev only) or "s3" (any S3-compatible: AWS S3, Cloudflare R2, Supabase S3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Demo workspace login (seeded by `pnpm db:seed`)
DEMO_USER_EMAIL="demo@tradepilot.local"
# Password for the demo user (the demo is meant to be public; change it anyway in production)
DEMO_USER_PASSWORD="change-me"
